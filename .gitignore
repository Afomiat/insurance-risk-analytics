# Virtual environment
venv/
env/
.env/

# Data files - tracked by DVC instead of Git
data/*.txt
data/*.csv
data/*.parquet
data/*.zip
data/*.xlsx

# Allow DVC pointer files through - NEVER ignore these
!data/*.dvc

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Jupyter checkpoints
.ipynb_checkpoints/

# Environment files
.env

# OS files
.DS_Store
Thumbs.db
